{
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua"
  ],
  "diagnostics.globals": ["vim",
        "dap"],
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "$VIMRUNTIME",
    "${3rd}/luv/library",
    "$HOME/.local/share/nvim/lazy/snacks.nvim/lua",
    "$HOME/.local/share/nvim/lazy/qssjira.nvim/lua",
    "$HOME/.local/share/nvim/lazy/qssoverseer.nvim/lua",
    "$HOME/.local/share/nvim/lazy/qssoverseer-tools.nvim/lua",
    "$HOME/.local/share/nvim/lazy/qssoverseer-kas.nvim/lua",
    "$HOME/.local/share/nvim/lazy/qsscpp-qt-tooling.nvim/lua"
  ]
}
